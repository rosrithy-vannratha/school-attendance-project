rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Check if user is accessing their own profile
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default safety catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection doc (Temporary: Delete this block in production)
    match /test/{docId} {
      allow read, write: if true;
    }

    // User profiles & user tasks (Users can only access their own data)
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // School data (Requires authentication to read or write)
    match /students/{studentId} {
      allow read, write: if isSignedIn();
    }

    match /teachers/{teacherId} {
      allow read, write: if isSignedIn();
    }

    match /classes/{classId} {
      allow read, write: if isSignedIn();
    }

    match /majors/{majorId} {
      allow read, write: if isSignedIn();
    }

    // Attendance records (Requires authentication)
    match /attendance/{attendanceId} {
      allow read, write: if isSignedIn();
    }

    match /teacher_attendance/{id} {
      allow read, write: if isSignedIn();
    }

    // System backups (Completely blocked from frontend client access)
    // Server-side Admin SDKs and Cloud Functions automatically bypass these rules
    match /backups/{backupId} {
      allow read, write: if false;
    }
  }
}
