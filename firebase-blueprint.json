{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Institute student profile and academic enrollment information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentCode": { "type": "string" },
        "nameKhmer": { "type": "string" },
        "nameLatin": { "type": "string" },
        "nameChinese": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "dob": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "majorId": { "type": "string" },
        "majorName": { "type": "string" },
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "shift": { "type": "string", "enum": ["morning", "afternoon", "evening", "weekend"] },
        "year": { "type": "string", "enum": ["Year 1", "Year 2", "Year 3", "Year 4"] },
        "status": { "type": "string", "enum": ["active", "suspended", "dropped", "graduated"] },
        "photoUrl": { "type": "string" },
        "address": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "studentCode", "nameKhmer", "gender", "shift", "year", "status"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Faculty and instructors at the institute",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherCode": { "type": "string" },
        "nameKhmer": { "type": "string" },
        "nameLatin": { "type": "string" },
        "nameChinese": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female"] },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "subjects": { "type": "string" },
        "shift": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "on_leave", "resigned"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "teacherCode", "nameKhmer", "gender", "status"]
    },
    "Classroom": {
      "title": "Classroom",
      "description": "Academic classrooms organized by major, year, and shift",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "classCode": { "type": "string" },
        "name": { "type": "string" },
        "majorId": { "type": "string" },
        "majorName": { "type": "string" },
        "year": { "type": "string", "enum": ["Year 1", "Year 2", "Year 3", "Year 4"] },
        "shift": { "type": "string", "enum": ["morning", "afternoon", "evening", "weekend"] },
        "room": { "type": "string" },
        "academicYear": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "classCode", "name", "shift", "year"]
    },
    "Major": {
      "title": "Major",
      "description": "Institute academic department / major program",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "nameKhmer": { "type": "string" },
        "nameLatin": { "type": "string" },
        "description": { "type": "string" },
        "totalYears": { "type": "number" }
      },
      "required": ["id", "code", "nameKhmer"]
    },
    "StudyDuration": {
      "title": "StudyDuration",
      "description": "Degree program durations and classifications (Associate, Bachelor, Master, PhD)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameKhmer": { "type": "string" },
        "nameLatin": { "type": "string" },
        "years": { "type": "number" },
        "degreeLevel": { "type": "string" },
        "description": { "type": "string" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["id", "nameKhmer", "years"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Student daily attendance log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "classId": { "type": "string" },
        "shift": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "permission", "absent", "late"] },
        "note": { "type": "string" },
        "recordedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "date", "classId", "studentId", "status"]
    },
    "TeacherAttendance": {
      "title": "TeacherAttendance",
      "description": "Teacher attendance log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "shift": { "type": "string" },
        "subject": { "type": "string" },
        "room": { "type": "string" },
        "status": { "type": "string", "enum": ["present", "permission", "absent", "substituted"] },
        "note": { "type": "string" },
        "recordedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "date", "teacherId", "status"]
    },
    "BackupSnapshot": {
      "title": "BackupSnapshot",
      "description": "Complete database snapshot backup",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdBy": { "type": "string" },
        "totalStudents": { "type": "number" },
        "totalTeachers": { "type": "number" },
        "totalClasses": { "type": "number" },
        "totalMajors": { "type": "number" },
        "totalAttendance": { "type": "number" },
        "totalTeacherAttendance": { "type": "number" },
        "data": { "type": "string" }
      },
      "required": ["id", "timestamp"]
    },
    "ShiftItem": {
      "title": "ShiftItem",
      "description": "Study shift options and schedule times",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "nameKhmer": { "type": "string" },
        "nameLatin": { "type": "string" },
        "timeRange": { "type": "string" },
        "days": { "type": "string" },
        "color": { "type": "string" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["id", "nameKhmer", "timeRange"]
    },
    "GenerationItem": {
      "title": "GenerationItem",
      "description": "Student intake batch / generation information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "nameKhmer": { "type": "string" },
        "nameLatin": { "type": "string" },
        "academicYear": { "type": "string" },
        "startYear": { "type": "string" },
        "endYear": { "type": "string" },
        "description": { "type": "string" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["id", "nameKhmer"]
    },
    "ScholarshipOption": {
      "title": "ScholarshipOption",
      "description": "Scholarship types and discount brackets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nameKhmer": { "type": "string" },
        "nameLatin": { "type": "string" },
        "discountPercentage": { "type": "number" },
        "badgeBg": { "type": "string" },
        "badgeText": { "type": "string" },
        "description": { "type": "string" },
        "isDefault": { "type": "boolean" }
      },
      "required": ["id", "nameKhmer", "discountPercentage"]
    },
    "TuitionPayment": {
      "title": "TuitionPayment",
      "description": "Tuition fees, scholarship discounts, and payment records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "studentCode": { "type": "string" },
        "studentName": { "type": "string" },
        "academicYear": { "type": "string" },
        "term": { "type": "string" },
        "scholarshipType": { "type": "string" },
        "discountPercentage": { "type": "number" },
        "originalAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "finalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "dueAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["paid", "partial", "pending", "overdue", "waived"] },
        "paymentDate": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "transactionRef": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "recordedBy": { "type": "string" },
        "dueDate": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "studentId", "studentCode", "studentName", "scholarshipType", "originalAmount", "finalAmount", "paidAmount", "status"]
    },
    "AbsenceAlertLog": {
      "title": "AbsenceAlertLog",
      "description": "Automated and manual attendance alert logs via Telegram / SMS",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "studentId": { "type": "string" },
        "studentCode": { "type": "string" },
        "studentName": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "className": { "type": "string" },
        "shift": { "type": "string" },
        "absentCount": { "type": "number" },
        "attendanceRate": { "type": "number" },
        "channel": { "type": "string", "enum": ["telegram", "sms", "phone_call"] },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["sent", "failed", "pending"] },
        "sentAt": { "type": "string" },
        "sentBy": { "type": "string" }
      },
      "required": ["id", "date", "studentId", "studentCode", "studentName", "absentCount", "channel", "status"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "All student records"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "All faculty and teacher records"
    },
    "/classes/{classId}": {
      "schema": "Classroom",
      "description": "Classrooms and batches"
    },
    "/majors/{majorId}": {
      "schema": "Major",
      "description": "Academic majors"
    },
    "/study_durations/{durationId}": {
      "schema": "StudyDuration",
      "description": "Study duration program categories"
    },
    "/shifts/{shiftId}": {
      "schema": "ShiftItem",
      "description": "Study shift timing options"
    },
    "/generations/{generationId}": {
      "schema": "GenerationItem",
      "description": "Student intake batches and generations"
    },
    "/scholarships/{scholarshipId}": {
      "schema": "ScholarshipOption",
      "description": "Institute scholarship discount categories"
    },
    "/attendance/{attendanceId}": {
      "schema": "AttendanceRecord",
      "description": "Student attendance entries"
    },
    "/teacher_attendance/{id}": {
      "schema": "TeacherAttendance",
      "description": "Teacher attendance logs"
    },
    "/tuition_payments/{paymentId}": {
      "schema": "TuitionPayment",
      "description": "Tuition and scholarship payments"
    },
    "/absence_alerts/{alertId}": {
      "schema": "AbsenceAlertLog",
      "description": "Sent attendance alerts"
    },
    "/backups/{backupId}": {
      "schema": "BackupSnapshot",
      "description": "Full system backup records"
    }
  }
}
